# Personal sign-in is the default. `local` is for a trusted loopback-only test server.
COURTSIDE_AUTH_MODE=personal
# Set production only behind a trusted HTTPS reverse proxy.
COURTSIDE_ENV=development
# This must exactly match the site and Google OAuth redirect URI.
COURTSIDE_ORIGIN=
COURTSIDE_GOOGLE_CLIENT_ID=
COURTSIDE_GOOGLE_CLIENT_SECRET=
COURTSIDE_STORAGE=storage
COURTSIDE_HOST=127.0.0.1
COURTSIDE_PORT=8000
# Set a long random token before binding to a non-loopback interface.
COURTSIDE_TOKEN=
COURTSIDE_MODEL=models/pose_landmarker_full.task
COURTSIDE_RETENTION_DAYS=30
COURTSIDE_MAX_UPLOAD_MB=1024
